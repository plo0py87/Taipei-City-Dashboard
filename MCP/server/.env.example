# 數據庫配置 - Dashboard 資料庫
DB_DASHBOARD_HOST=postgres-data
DB_DASHBOARD_PORT=5432
DB_DASHBOARD_NAME=dashboard
DB_DASHBOARD_USER=postgres
DB_DASHBOARD_PASSWORD=postgres

# 數據庫配置 - Manager 資料庫
DB_MANAGER_HOST=postgres-manager
DB_MANAGER_PORT=5432
DB_MANAGER_NAME=dashboardmanager
DB_MANAGER_USER=postgres
DB_MANAGER_PASSWORD=postgres

# 本地開發環境 (如果不使用 Docker)
# DB_DASHBOARD_HOST=localhost
# DB_MANAGER_HOST=localhost
